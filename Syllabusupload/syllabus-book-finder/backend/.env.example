# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./syllabus_books.db

# Storage
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_SIZE_MB=25

# Optional Third-Party API Keys (Works without keys via public rate limits)
GOOGLE_BOOKS_API_KEY=

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Tesseract Executable Path (if not in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
